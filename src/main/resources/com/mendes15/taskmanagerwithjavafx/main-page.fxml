<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>

<VBox prefHeight="600.0" prefWidth="800.0" alignment="CENTER" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mendes15.taskmanagerwithjavafx.controller.MainController" stylesheets="@styles.css">
    <VBox styleClass="card">
        <HBox spacing="8.0">
            <Button text="Start" prefWidth="100" onAction="#handleClickStart" />
            <Button text="Tasks" prefWidth="100" onAction="#getAllTasks" />
            <Button text="Users" prefWidth="100" onAction="#getAllUsers" />
            <Button text="Exit" prefWidth="100" onAction="#handleClickExit" />
        </HBox>
        <VBox spacing="8.0">
            <TextArea fx:id="usersList" prefHeight="400.0" prefWidth="700.0" editable="false" visible="false" managed="false" />
            <VBox fx:id="tasksByUser" prefHeight="400.0" prefWidth="700.0" visible="false" managed="false" />
            <TextField fx:id="taskTitle" prefHeight="30.0" prefWidth="700.0" promptText="Add title here" />
            <TextField fx:id="taskContent" prefHeight="30.0" prefWidth="700.0" promptText="Add content here" />
            <Button text="Create Task" prefWidth="100" onAction="#createTask" />
        </VBox>
    </VBox>
</VBox>