<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Hyperlink?>
<VBox prefHeight="600.0" prefWidth="800.0" alignment="CENTER" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mendes15.taskmanagerwithjavafx.controller.RegisterController" stylesheets="@styles.css">
    <VBox styleClass="card">
        <VBox spacing="8.0" fillWidth="false">

            <TextField fx:id="txtUsername" promptText="Username" prefWidth="250"/>
            <TextField fx:id="txtEmail" promptText="Email" prefWidth="250"/>
            <PasswordField fx:id="txtPassword" promptText="Password" prefWidth="250"/>
            <Hyperlink fx:id="lnkLogin" text="Back to login" onAction="#handleBackToLogin" />
            <Button text="Sign-in" prefWidth="100" onAction="#signin"/>

        </VBox>
    </VBox>
</VBox>
